<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licenses of cwlogs-retention</title>
</head>
<body>
<h1>Third-party licenses</h1>
<p>The cwlogs-retention binary includes the Rust crates below. Their license texts follow the list.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
